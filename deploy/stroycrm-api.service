[Unit]
Description=StroyCRM Nest API
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/stroycrm/backend
Environment=NODE_ENV=production
EnvironmentFile=-/opt/stroycrm/backend/.env
ExecStart=/usr/bin/node dist/main.js
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
